VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://context-assistant.local/api
VITE_GITHUB_CONNECTION=github-veto
AUTH0_AUDIENCE=https://context-assistant.local/api
# Server-only credentials: never add a VITE_ prefix or commit .env.
TOKEN_VAULT_CLIENT_ID=
TOKEN_VAULT_CLIENT_SECRET=
CIBA_CLIENT_ID=
CIBA_CLIENT_SECRET=
GITHUB_DEMO_REPO=your-user/auth0-veto-agent
